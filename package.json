{
  "name": "projecthub",
  "private": true,
  "version": "0.1.0",
  "description": "ProjectHub - open-source, self-hosted project management platform",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* run build",
    "dev:api": "pnpm --filter @projecthub/api run dev",
    "dev:web": "pnpm --filter @projecthub/web run dev",
    "test": "pnpm --filter @projecthub/api run test",
    "test:api": "pnpm --filter @projecthub/api run test",
    "lint": "pnpm -r run lint",
    "prisma:generate": "pnpm --filter @projecthub/api run prisma:generate",
    "prisma:migrate": "pnpm --filter @projecthub/api run prisma:migrate",
    "prisma:migrate:deploy": "pnpm --filter @projecthub/api run prisma:migrate:deploy"
  }
}
