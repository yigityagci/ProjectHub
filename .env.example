# ProjectHub environment configuration.
# Copy this file to `.env` and fill in real values before running
# docker-compose or the API locally. Never commit a real `.env` file.

# --- General ---
NODE_ENV=production
# Port the API listens on inside its container / locally.
PORT=4000
# Public URL of the API itself (used to build absolute links).
APP_URL=http://localhost:4000
# Public URL of the frontend SPA (used to build invitation accept links).
WEB_URL=http://localhost:5173

# --- Database ---
# Used by both the `api` service and docker-compose's `db` service.
POSTGRES_USER=projecthub
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=projecthub
DATABASE_URL=postgresql://projecthub:change-me-to-a-strong-password@db:5432/projecthub

# --- Redis (cache / rate-limit / job queue) ---
REDIS_URL=redis://redis:6379

# --- Security ---
# A long, random, secret string used to derive CSRF tokens and other
# server-side secrets. Generate one with e.g.:
#   openssl rand -base64 48
# Must be at least 32 characters. The app refuses to boot in production
# without a sufficiently strong value.
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Idle session expiry (slides forward on activity) and absolute expiry
# (hard cutoff regardless of activity), in hours.
SESSION_TTL_HOURS=24
SESSION_ABSOLUTE_TTL_HOURS=720

# Whether the session cookie requires HTTPS. Set to true in any real
# deployment served over HTTPS (which self-hosted production deployments
# should always be, e.g. behind a reverse proxy with TLS).
COOKIE_SECURE=false

# Comma-separated list of allowed CORS origins (the frontend's origin).
CORS_ORIGIN=http://localhost:5173

# --- Email (optional) ---
# If left unset, invitation emails are logged to the API's console output
# instead of being sent, so the invite flow can be exercised without a
# real mail server. Wiring a real SMTP transport is planned for a later
# phase; these variables are reserved for that.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# SMTP_FROM="ProjectHub <no-reply@example.com>"

# --- Rate limiting (optional overrides) ---
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MINUTES=1

# --- Invitations ---
INVITE_TTL_HOURS=168

# --- Password hashing (argon2id) tuning ---
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
