# ProjectHub environment configuration.
# Copy this file to `.env` and fill in real values before running
# docker-compose or the API locally. Never commit a real `.env` file.

# --- General ---
NODE_ENV=production
# Port the API listens on inside its container / locally.
PORT=4000
# Public URL of the API itself (used to build absolute links). This is
# also baked into the web UI's production build (as VITE_API_URL, see
# docker-compose.yml) so the browser knows where to send API requests -
# changing this value requires re-running `docker-compose build web`.
APP_URL=http://localhost:4000
# Public URL of the frontend SPA (used to build invitation accept links).
WEB_URL=http://localhost:5173
# Host port the web UI is published on via docker-compose (container
# always listens on 5173 internally).
WEB_PORT=5173

# --- Database ---
# Used by both the `api` service and docker-compose's `db` service.
POSTGRES_USER=projecthub
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=projecthub
DATABASE_URL=postgresql://projecthub:change-me-to-a-strong-password@db:5432/projecthub

# --- Redis (cache / rate-limit / job queue) ---
REDIS_URL=redis://redis:6379

# --- Security ---
# A long, random, secret string used to derive CSRF tokens and other
# server-side secrets. Generate one with e.g.:
#   openssl rand -base64 48
# Must be at least 32 characters. The app refuses to boot in production
# without a sufficiently strong value.
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Idle session expiry (slides forward on activity) and absolute expiry
# (hard cutoff regardless of activity), in hours.
SESSION_TTL_HOURS=24
SESSION_ABSOLUTE_TTL_HOURS=720

# Whether the session cookie requires HTTPS. Set to true in any real
# deployment served over HTTPS (which self-hosted production deployments
# should always be, e.g. behind a reverse proxy with TLS).
COOKIE_SECURE=false

# Comma-separated list of allowed CORS origins (the frontend's origin).
CORS_ORIGIN=http://localhost:5173

# --- Email (optional) ---
# Outbound email (SMTP) is no longer configured via environment variables.
# It's configured at runtime by a platform administrator from
# Settings > ProjectHub Administration (/settings/projecthub-admin), stored in the
# platform_email_configs table. Until an admin configures and enables it,
# invitation/password-reset/notification emails are logged to the API's
# console output instead of being sent, so those flows can still be
# exercised end-to-end without a real mail server.

# --- Rate limiting (optional overrides) ---
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MINUTES=1

# --- Invitations ---
INVITE_TTL_HOURS=168

# --- Registration tokens (gate account creation, see Manage Team) ---
REGISTRATION_TOKEN_TTL_DAYS=30

# --- Password hashing (argon2id) tuning ---
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Uploads (Phase 4 attachments, local-disk StorageProvider) ---
# Directory the local-disk StorageProvider writes to, relative to the API
# process's working directory (matches the `uploads` volume in
# docker-compose.yml).
UPLOAD_DIR=uploads
# Maximum upload size in bytes (default 25MB). Enforced by @fastify/multipart
# at parse time, in addition to the content-type allowlist enforced by the
# attachments service.
UPLOAD_MAX_SIZE_BYTES=26214400

# --- Scheduler (shared in-process poller) ---
# How often the API's single background poller wakes up, in milliseconds.
# Nothing is registered against it yet, so a tick currently does no work.
SCHEDULER_POLL_INTERVAL_MS=5000
