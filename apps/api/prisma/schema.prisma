// ProjectHub — Phase 1 Prisma schema.
//
// Only the Phase 1 entity subset is modeled here: User, Session, Workspace,
// Role, RolePermission, WorkspaceMembership, Invitation, AuditLogEntry.
// The full target schema (Team, Project, Task, Comment, Notification, ...)
// is documented in docs/ARCHITECTURE.md and will be added in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  disabled
}

enum RoleKey {
  OWNER
  ADMIN
  PROJECT_MANAGER
  MEMBER
  VIEWER
  CLIENT
}

enum MembershipStatus {
  active
  suspended
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum ProjectStatus {
  planning
  active
  on_hold
  completed
}

enum ProjectVisibility {
  workspace
  private
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum ColumnCategory {
  todo
  in_progress
  done
}

enum NotificationType {
  mention
  task_assigned
  comment_reply
}

enum ActivityEventType {
  task_created
  task_moved
  task_assigned
  comment_added
  milestone_completed
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  displayName     String
  avatarUrl       String?
  isPlatformAdmin Boolean    @default(false)
  status          UserStatus @default(active)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions             Session[]
  ownedWorkspaces      Workspace[]         @relation("WorkspaceOwner")
  memberships          WorkspaceMembership[]
  sentInvitations      Invitation[]        @relation("InvitationInvitedBy")
  acceptedInvitations  Invitation[]        @relation("InvitationAcceptedBy")
  auditLogEntries      AuditLogEntry[]

  ownedProjects        Project[]           @relation("ProjectOwner")
  projectMemberships   ProjectMembership[]
  createdTasks         Task[]              @relation("TaskCreator")
  taskAssignments      TaskAssignee[]

  commentsAuthored     Comment[]           @relation("CommentAuthor")
  mentionsReceived     Mention[]           @relation("MentionedUser")
  notifications        Notification[]      @relation("NotificationRecipient")
  attachmentsUploaded  Attachment[]        @relation("AttachmentUploader")
  activityEvents       ActivityEvent[]     @relation("ActivityEventActor")

  @@map("users")
}

model Session {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  lastSeenAt        DateTime  @default(now())
  revokedAt         DateTime?
  ip                String?
  userAgent         String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles       Role[]
  memberships WorkspaceMembership[]
  invitations Invitation[]
  auditLogEntries AuditLogEntry[]

  projects           Project[]
  projectMemberships ProjectMembership[]
  boardColumns       BoardColumn[]
  tasks              Task[]
  taskAssignees      TaskAssignee[]
  labels             Label[]
  taskLabels         TaskLabel[]
  milestones         Milestone[]
  taskDependencies   TaskDependency[]

  comments      Comment[]
  mentions      Mention[]
  notifications Notification[]
  attachments   Attachment[]
  activityEvents ActivityEvent[]

  @@index([ownerId])
  @@map("workspaces")
}

model Role {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key         RoleKey
  name        String
  isSystem    Boolean  @default(true)

  permissions  RolePermission[]
  memberships  WorkspaceMembership[]
  invitations  Invitation[]

  @@unique([workspaceId, key])
  @@map("roles")
}

model RolePermission {
  id         String @id @default(uuid())
  roleId     String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String

  @@unique([roleId, permission])
  @@map("role_permissions")
}

model WorkspaceMembership {
  id          String           @id @default(uuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String
  role        Role             @relation(fields: [roleId], references: [id])
  status      MembershipStatus @default(active)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_memberships")
}

model Invitation {
  id             String            @id @default(uuid())
  workspaceId    String
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email          String
  roleId         String
  role           Role              @relation(fields: [roleId], references: [id])
  tokenHash      String            @unique
  invitedById    String
  invitedBy      User              @relation("InvitationInvitedBy", fields: [invitedById], references: [id])
  status         InvitationStatus  @default(pending)
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  acceptedUser   User?             @relation("InvitationAcceptedBy", fields: [acceptedUserId], references: [id])
  createdAt      DateTime          @default(now())

  @@index([workspaceId, email])
  @@map("invitations")
}

model AuditLogEntry {
  id          String    @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  targetType  String?
  targetId    String?
  metadata    Json      @default("{}")
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([action])
  @@map("audit_log_entries")
}

// ---------------------------------------------------------------------------
// Phase 2 — Projects, Tasks, Subtasks, Kanban CRUD
// ---------------------------------------------------------------------------

model Project {
  id          String            @id @default(uuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  ownerId     String
  owner       User              @relation("ProjectOwner", fields: [ownerId], references: [id])
  status      ProjectStatus     @default(planning)
  visibility  ProjectVisibility @default(workspace)
  startDate   DateTime?
  targetDate  DateTime?
  archived    Boolean           @default(false)
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  memberships  ProjectMembership[]
  columns      BoardColumn[]
  tasks        Task[]
  labels       Label[]
  milestones   Milestone[]
  dependencies TaskDependency[]
  activityEvents ActivityEvent[]

  @@index([workspaceId])
  @@index([ownerId])
  @@map("projects")
}

model ProjectMembership {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([projectId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("project_memberships")
}

model BoardColumn {
  id          String         @id @default(uuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  category    ColumnCategory
  position    Float
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tasks Task[]

  @@unique([projectId, name])
  @@index([workspaceId])
  @@index([projectId, position])
  @@map("board_columns")
}

model Task {
  id           String       @id @default(uuid())
  workspaceId  String
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columnId     String
  column       BoardColumn  @relation(fields: [columnId], references: [id], onDelete: Restrict)
  parentTaskId String?
  parentTask   Task?        @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]       @relation("TaskSubtasks")
  milestoneId  String?
  milestone    Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  priority     TaskPriority @default(medium)
  position     Float
  creatorId    String
  creator      User         @relation("TaskCreator", fields: [creatorId], references: [id])
  startDate    DateTime?
  dueDate      DateTime?
  // Set the moment this task's column transitions into a `done`-category
  // column (moveTask in tasks.service.ts), cleared if it's moved back out of
  // done. Phase 6 analytics (completion-over-time, average completion time)
  // depend entirely on this timestamp actually reflecting when work finished,
  // not just `updatedAt` (which changes on every unrelated edit too).
  completedAt  DateTime?
  version      Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assignees          TaskAssignee[]
  labels             TaskLabel[]
  blockedByEdges     TaskDependency[] @relation("TaskBlocked")
  blockingEdges      TaskDependency[] @relation("TaskBlocking")
  comments           Comment[]
  attachments        Attachment[]

  @@index([workspaceId])
  @@index([projectId, columnId, position])
  @@index([parentTaskId])
  @@index([milestoneId])
  @@index([creatorId])
  @@map("tasks")
}

model TaskAssignee {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt  DateTime @default(now())

  @@unique([taskId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("task_assignees")
}

model Label {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  color       String
  createdAt   DateTime @default(now())

  taskLabels TaskLabel[]

  @@unique([projectId, name])
  @@index([workspaceId])
  @@map("labels")
}

model TaskLabel {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  labelId     String
  label       Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([taskId, labelId])
  @@index([workspaceId])
  @@index([labelId])
  @@map("task_labels")
}

model Milestone {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  targetDate  DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks Task[]

  @@index([workspaceId])
  @@index([projectId])
  @@map("milestones")
}

model TaskDependency {
  id             String   @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  blockedTaskId  String
  blockedTask    Task     @relation("TaskBlocked", fields: [blockedTaskId], references: [id], onDelete: Cascade)
  blockingTaskId String
  blockingTask   Task     @relation("TaskBlocking", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([blockedTaskId, blockingTaskId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([blockingTaskId])
  @@map("task_dependencies")
}

// ---------------------------------------------------------------------------
// Phase 4 — Comments, mentions, notifications, attachments
// ---------------------------------------------------------------------------
//
// Mention parsing convention (documented here, see also docs/PHASES.md):
// the frontend's mention-autocomplete inserts opaque `@[userId]` tokens into
// the comment body (never free-text name matching, which would be ambiguous
// with duplicate display names). The server re-parses these tokens at
// comment-creation time and only honors ones that resolve to an active
// workspace member — the token is the source of truth, never trusted
// display text.

model Comment {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation("CommentAuthor", fields: [authorId], references: [id])
  body        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  mentions Mention[]

  @@index([workspaceId])
  @@index([taskId, createdAt])
  @@map("comments")
}

model Mention {
  id              String   @id @default(uuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  commentId       String
  comment         Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUserId String
  mentionedUser   User     @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([workspaceId])
  @@index([commentId])
  @@index([mentionedUserId])
  @@map("mentions")
}

model Notification {
  id              String           @id @default(uuid())
  workspaceId     String
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipientUserId String
  recipient       User             @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  type            NotificationType
  payload         Json             @default("{}")
  readAt          DateTime?
  createdAt       DateTime         @default(now())

  @@index([recipientUserId, createdAt])
  @@index([workspaceId])
  @@map("notifications")
}

model Attachment {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploaderId  String
  uploader    User     @relation("AttachmentUploader", fields: [uploaderId], references: [id])
  filename    String
  contentType String
  sizeBytes   Int
  storageKey  String   @unique
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([taskId])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// Phase 5 — Activity feed (separate from the Phase 1 security AuditLogEntry)
// ---------------------------------------------------------------------------
//
// ActivityEvent is a user-facing, ordinary-project-activity feed (task
// created/moved/assigned, comment posted, milestone completed) — NOT a
// security/admin log. It denormalizes human-readable context (task title,
// column names, actor display name) directly into `payload` so the feed can
// render without re-joining to Task/BoardColumn/User at read time, since
// those referenced rows may themselves change or be deleted later.

model ActivityEvent {
  id          String            @id @default(uuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User              @relation("ActivityEventActor", fields: [actorId], references: [id])
  type        ActivityEventType
  payload     Json              @default("{}")
  createdAt   DateTime          @default(now())

  @@index([workspaceId])
  @@index([projectId, createdAt])
  @@map("activity_events")
}
