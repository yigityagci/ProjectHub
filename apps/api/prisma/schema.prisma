// ProjectHub — Phase 1 Prisma schema.
//
// Only the Phase 1 entity subset is modeled here: User, Session, Workspace,
// Role, RolePermission, WorkspaceMembership, Invitation, AuditLogEntry.
// The full target schema (Team, Project, Task, Comment, Notification, ...)
// is documented in docs/ARCHITECTURE.md and will be added in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  disabled
  // Soft-delete marker for self-service account deletion (see
  // auth/account.service.ts#deleteAccount). Deliberately reuses the three
  // existing `status !== "active"` gates that already block session
  // resolution (session.ts#resolveSession), login (auth.routes.ts), and
  // password-reset issuance (password-reset.service.ts) — a deleted
  // account gets those "for free" without new conditionals at each site.
  deleted
}

enum RoleKey {
  OWNER
  ADMIN
  PROJECT_MANAGER
  MEMBER
  VIEWER
  CLIENT
}

enum MembershipStatus {
  active
  suspended
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum ProjectStatus {
  planning
  active
  on_hold
  completed
}

enum ProjectVisibility {
  workspace
  private
}

// TaskCategory's own visibility enum — deliberately named CategoryVisibility
// (NOT reusing/confusing with ColumnCategory, which is the todo/in_progress/
// done classification of a BoardColumn). Mirrors ProjectVisibility exactly,
// one level down: a category is visible to every project member by default
// ("workspace"), or can be restricted to an explicit CategoryMembership list
// ("private").
enum CategoryVisibility {
  workspace
  private
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum ColumnCategory {
  todo
  in_progress
  done
}

// Custom-field types for project-scoped CustomFieldDefinition. `multi_select`
// is snake_case because Prisma enum members must be valid identifiers —
// mirrors ColumnCategory's `in_progress`, and is the literal wire value used
// by packages/shared's CUSTOM_FIELD_TYPES.
enum CustomFieldType {
  text
  number
  date
  select
  multi_select
  checkbox
  url
}

enum NotificationType {
  mention
  task_assigned
  comment_reply
  due_date_soon
}

enum SmtpSecurity {
  none      // plaintext, no TLS at all (nodemailer: ignoreTLS)
  starttls  // plaintext connect, upgrade via STARTTLS (port 587) — the default
  tls       // implicit TLS from the first byte (port 465)
}

enum ActivityEventType {
  task_created
  task_moved
  task_assigned
  comment_added
  milestone_completed
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  displayName     String
  avatarUrl       String?
  isPlatformAdmin Boolean    @default(false)
  status          UserStatus @default(active)
  // Informational-only "when did this happen" timestamp for account
  // deletion — `status` above is the actual source of truth for "is this
  // account deleted" (see users/user-serialization.ts#isDeletedUser). Not
  // used for any gating logic, purely support/audit context.
  deletedAt       DateTime?
  // Settings page preferences (see docs/PHASES.md). Scalar columns rather
  // than a JSON blob, deliberately: the notification-preference set is
  // closed and already double-enumerated (NOTIFICATION_TYPES in
  // packages/shared, and the NotificationType enum below), so a
  // Record<NotificationType, ...> column map makes forgetting to gate a new
  // notification type a compile error (see notifications.service.ts),
  // which a JSON blob could never guarantee.
  notifyOnMention       Boolean  @default(true)
  notifyOnTaskAssigned  Boolean  @default(true)
  notifyOnCommentReply  Boolean  @default(true)
  notifyOnDueDate Boolean @default(true)
  locale                String   @default("en")
  prefersReducedMotion  Boolean  @default(false)
  prefersLargerText     Boolean  @default(false)
  // Personalization tab (see docs/PHASES.md). Same scalar-column convention
  // as the accessibility/locale columns above: a plain String with the
  // allowed-value set enforced by a shared zod enum
  // (BOARD_VIEWS/LANDING_PAGES in packages/shared), not a Prisma enum, so
  // adding a third board view or landing page later is a tuple append, not
  // a migration.
  defaultBoardView              String  @default("board")
  defaultLandingPage            String  @default("workspaces")
  prefersCompactMode             Boolean @default(false)
  showKeyboardShortcutsReference Boolean @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  ownedWorkspaces     Workspace[]           @relation("WorkspaceOwner")
  memberships         WorkspaceMembership[]
  sentInvitations     Invitation[]          @relation("InvitationInvitedBy")
  acceptedInvitations Invitation[]          @relation("InvitationAcceptedBy")
  // Both sides are plural even though, by construction, a user can only
  // ever be the `usedBy` of a single RegistrationToken (registerUser
  // creates the user and marks the token used in the same transaction) —
  // usedByUserId is deliberately not @unique (mirrors Invitation's
  // acceptedUserId, which has the same one-user-many-possible-rows FK
  // shape), so Prisma requires the array form here regardless.
  createdRegistrationTokens RegistrationToken[] @relation("RegistrationTokenCreatedBy")
  usedRegistrationTokens    RegistrationToken[] @relation("RegistrationTokenUsedBy")
  auditLogEntries     AuditLogEntry[]
  platformEmailConfigUpdates PlatformEmailConfig[] @relation("PlatformEmailConfigUpdatedBy")

  ownedProjects       Project[]            @relation("ProjectOwner")
  projectMemberships  ProjectMembership[]
  categoryMemberships CategoryMembership[]
  createdTasks        Task[]               @relation("TaskCreator")
  taskAssignments     TaskAssignee[]

  commentsAuthored    Comment[]       @relation("CommentAuthor")
  mentionsReceived    Mention[]       @relation("MentionedUser")
  notifications       Notification[]  @relation("NotificationRecipient")
  attachmentsUploaded Attachment[]    @relation("AttachmentUploader")
  activityEvents      ActivityEvent[] @relation("ActivityEventActor")

  @@map("users")
}

model Session {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  lastSeenAt        DateTime  @default(now())
  revokedAt         DateTime?
  ip                String?
  userAgent         String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Self-service password reset. A raw token is emailed to the user (never
// stored); only its sha256 hash is persisted, mirroring the Session /
// Invitation token pattern (see session.ts#hashToken,
// invitations.service.ts). Single-use (`usedAt`) and short-lived
// (`expiresAt`, PASSWORD_RESET_TTL_HOURS — much shorter than an
// invitation's, since this token is a bearer credential to full account
// takeover if leaked).
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles              Role[]
  memberships        WorkspaceMembership[]
  invitations        Invitation[]
  registrationTokens RegistrationToken[]
  auditLogEntries    AuditLogEntry[]

  projects            Project[]
  projectMemberships  ProjectMembership[]
  taskCategories      TaskCategory[]
  categoryMemberships CategoryMembership[]
  boardColumns        BoardColumn[]
  tasks               Task[]
  taskAssignees       TaskAssignee[]
  labels              Label[]
  taskLabels          TaskLabel[]
  milestones          Milestone[]
  taskDependencies    TaskDependency[]
  customFieldDefinitions CustomFieldDefinition[]
  customFieldValues      CustomFieldValue[]
  taskTemplates          TaskTemplate[]

  comments       Comment[]
  mentions       Mention[]
  notifications  Notification[]
  attachments    Attachment[]
  activityEvents ActivityEvent[]

  @@index([ownerId])
  @@map("workspaces")
}

model Role {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key         RoleKey
  name        String
  isSystem    Boolean   @default(true)

  permissions RolePermission[]
  memberships WorkspaceMembership[]
  invitations Invitation[]
  registrationTokens RegistrationToken[]

  @@unique([workspaceId, key])
  @@map("roles")
}

model RolePermission {
  id         String @id @default(uuid())
  roleId     String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String

  @@unique([roleId, permission])
  @@map("role_permissions")
}

model WorkspaceMembership {
  id          String           @id @default(uuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String
  role        Role             @relation(fields: [roleId], references: [id])
  status      MembershipStatus @default(active)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_memberships")
}

model Invitation {
  id             String           @id @default(uuid())
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email          String
  roleId         String
  role           Role             @relation(fields: [roleId], references: [id])
  tokenHash      String           @unique
  invitedById    String
  invitedBy      User             @relation("InvitationInvitedBy", fields: [invitedById], references: [id])
  status         InvitationStatus @default(pending)
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  acceptedUser   User?            @relation("InvitationAcceptedBy", fields: [acceptedUserId], references: [id])
  createdAt      DateTime         @default(now())

  @@index([workspaceId, email])
  @@map("invitations")
}

// Gates account creation (see registration-token.service.ts): generated
// from within a specific workspace's Manage Team tab by an OWNER/ADMIN
// (registration_token.manage). Carries a roleId (like Invitation) — the
// generator picks the role the redeeming user will join this workspace
// with, and registerUser creates that WorkspaceMembership atomically with
// the User row. Mirrors PasswordResetToken's hashed-bearer-token shape,
// but longer-lived and multi-use-eligible in spirit
// (REGISTRATION_TOKEN_TTL_DAYS, see config/env.ts) since it's meant to be
// shared/reused more broadly than a single-recipient Invitation, while
// still being single-use in practice once redeemed (`usedAt`).
model RegistrationToken {
  id           String    @id @default(uuid())
  tokenHash    String    @unique
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  createdById  String
  createdBy    User      @relation("RegistrationTokenCreatedBy", fields: [createdById], references: [id])
  label        String?
  expiresAt    DateTime
  usedAt       DateTime?
  usedByUserId String?
  usedBy       User?     @relation("RegistrationTokenUsedBy", fields: [usedByUserId], references: [id])
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([workspaceId])
  @@index([roleId])
  @@map("registration_tokens")
}

model AuditLogEntry {
  id          String     @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  targetType  String?
  targetId    String?
  metadata    Json       @default("{}")
  ip          String?
  userAgent   String?
  createdAt   DateTime   @default(now())

  @@index([workspaceId, createdAt])
  @@index([action])
  @@map("audit_log_entries")
}

// ---------------------------------------------------------------------------
// Phase 2 — Projects, Tasks, Subtasks, Kanban CRUD
// ---------------------------------------------------------------------------

model Project {
  id          String            @id @default(uuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  ownerId     String
  owner       User              @relation("ProjectOwner", fields: [ownerId], references: [id])
  status      ProjectStatus     @default(planning)
  visibility  ProjectVisibility @default(workspace)
  startDate   DateTime?
  targetDate  DateTime?
  archived    Boolean           @default(false)
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  memberships    ProjectMembership[]
  categories     TaskCategory[]
  columns        BoardColumn[]
  tasks          Task[]
  labels         Label[]
  milestones     Milestone[]
  dependencies   TaskDependency[]
  activityEvents ActivityEvent[]
  customFields   CustomFieldDefinition[]
  taskTemplates  TaskTemplate[]

  @@index([workspaceId])
  @@index([ownerId])
  @@map("projects")
}

// ---------------------------------------------------------------------------
// Categories — a required sub-division inside each Project, one level
// between Project and BoardColumn/Task. Every category owns its own Kanban
// board (its own BoardColumns) and its own access-control layer, mirroring
// Project/ProjectVisibility/ProjectMembership exactly, one level down.
//
// Deliberately NOT named anything that could be confused with the
// `ColumnCategory` enum (BoardColumn's todo/in_progress/done classification)
// — this model is the structural "folder" grouping described in the product
// requirements, unrelated to that enum.
//
// Product rule: a brand-new project starts with ZERO categories (no
// auto-seeded default category name, ever) — see docs/PHASES.md for the
// two-step project-then-category creation UX this supports. This is
// distinct from the invariant enforced at the application layer
// (rbac/authorize.ts#assertNotLastCategory) that a project which already
// has >=1 category can never be reduced back to 0 via deletion.
model TaskCategory {
  id          String             @id @default(uuid())
  workspaceId String
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  visibility  CategoryVisibility @default(workspace)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  memberships    CategoryMembership[]
  columns        BoardColumn[]
  tasks          Task[]
  activityEvents ActivityEvent[]

  @@unique([projectId, name])
  @@index([workspaceId])
  @@map("task_categories")
}

model CategoryMembership {
  id          String       @id @default(uuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  categoryId  String
  category    TaskCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@unique([categoryId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("category_memberships")
}

model ProjectMembership {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([projectId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("project_memberships")
}

model BoardColumn {
  id           String         @id @default(uuid())
  workspaceId  String
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // projectId stays denormalized here even though categoryId (below) already
  // implies it — this codebase's established convention is to denormalize
  // the full parent chain onto every deep entity (see e.g. Task.workspaceId
  // even though Task.projectId already implies it).
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  categoryId   String
  // A category delete cascades to its own columns. In practice this only
  // ever fires on an EMPTY category: category deletion is blocked at the
  // application layer (categories.service.ts) whenever any of its columns
  // still has tasks, mirroring columns.service.ts#deleteColumn's existing
  // task-count check one level up.
  taskCategory TaskCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  category     ColumnCategory
  // Optional custom accent color (hex string, e.g. "#4F46E5"), independent
  // of `category` above — lets two columns in the same category-based
  // bucket (e.g. two "in_progress" columns) look different, or a user just
  // pick a color they like. Null means "fall back to the category-based
  // default color" (see apps/web/src/styles.css's ph-cat-* variables).
  color        String?
  position     Float
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tasks Task[]

  // Column names are unique within a category's own board now (not
  // project-wide) — a project can have multiple categories, each with its
  // own independent "To Do"/"In Progress"/"Done".
  @@unique([categoryId, name])
  @@index([workspaceId])
  @@index([projectId, position])
  @@index([categoryId, position])
  @@map("board_columns")
}

model Task {
  id           String       @id @default(uuid())
  workspaceId  String
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  categoryId   String
  // Restrict (not Cascade), mirroring `column`'s onDelete: Restrict below —
  // defense in depth against a race where a task is inserted into a
  // category between the app-layer "category has no tasks" check and the
  // delete itself (see categories.service.ts#deleteCategory /
  // assertNotLastCategory). A task belongs to exactly one category, implied
  // by which category's board its column lives on.
  taskCategory TaskCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  columnId     String
  column       BoardColumn  @relation(fields: [columnId], references: [id], onDelete: Restrict)
  parentTaskId String?
  parentTask   Task?        @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]       @relation("TaskSubtasks")
  // Recurring tasks — a SEPARATE self-relation from parentTaskId/
  // "TaskSubtasks" above (deliberately so: a task spawned by a recurring
  // template is a sibling task in the same category, never a subtask of the
  // template — see recurrence.service.ts and assertCanBeRecurrenceTemplate
  // in tasks.service.ts, which enforce that a subtask can never be/become a
  // template and a template's own instances can never chain into further
  // templates).
  //
  // onDelete: SetNull (not Cascade): deleting a template must never delete
  // the real work items it already produced. An instance's
  // recurrenceTemplateId simply goes null on template deletion — the
  // instance survives as an ordinary task.
  //
  // `recurrenceRule`'s shape (frequency/interval/end-condition) is enforced
  // exclusively by a zod schema in packages/shared (recurrenceRuleSchema)
  // and re-validated in tasks.service.ts — NEVER by the database. Same
  // precedent as CustomFieldDefinition.options above: Prisma cannot express
  // "this Json column's shape depends on runtime business rules", so this
  // invariant lives entirely at the application layer.
  //
  // `nextRunAt` null while `recurrenceRule` is non-null means the recurrence
  // is EXHAUSTED (its end condition — `until` or `count` — was reached).
  // This is a first-class "finished" state, not data loss: SQL NULL never
  // matches the scheduler's `{ lte: now }` claim filter again, so an
  // exhausted template costs nothing forever rather than needing to be
  // separately archived or deleted.
  //
  // `recurrenceCount` is a stored counter serving as BOTH the next
  // occurrence's 0-based index and the count of instances spawned so far.
  // Deliberately NOT derived by counting `recurrenceInstances` rows:
  // instances are user-deletable, and deriving the count from them would
  // incorrectly "un-exhaust" a finished recurrence if the user deletes a
  // spawned instance.
  recurrenceTemplateId String?
  recurrenceTemplate   Task?      @relation("TaskRecurrenceInstances", fields: [recurrenceTemplateId], references: [id], onDelete: SetNull)
  recurrenceInstances  Task[]     @relation("TaskRecurrenceInstances")
  recurrenceRule       Json?
  nextRunAt            DateTime?
  recurrenceCount      Int        @default(0)
  milestoneId  String?
  milestone    Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  priority     TaskPriority @default(medium)
  position     Float
  creatorId    String
  creator      User         @relation("TaskCreator", fields: [creatorId], references: [id])
  startDate    DateTime?
  dueDate      DateTime?
  // Set the moment a due-date-soon reminder notification has been created for
  // this task — this single column IS the claim marker for the scheduler's
  // due-date-reminder handler (see notifications/due-date-reminder.service.ts):
  // there's no "next occurrence" to advance, unlike recurrence's
  // nextRunAt/recurrenceCount pair, so a plain null->timestamp transition is
  // the entire claim. Cleared back to null by tasks.service.ts#updateTask
  // whenever `dueDate` is included in a PATCH at all (even set to its current
  // value, or to null), so a task whose reminder already fired is re-armed
  // under its new due date rather than staying silenced forever.
  dueReminderSentAt DateTime?
  // Set the moment this task's column transitions into a `done`-category
  // column (moveTask in tasks.service.ts), cleared if it's moved back out of
  // done. Phase 6 analytics (completion-over-time, average completion time)
  // depend entirely on this timestamp actually reflecting when work finished,
  // not just `updatedAt` (which changes on every unrelated edit too).
  completedAt  DateTime?
  version      Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assignees      TaskAssignee[]
  labels         TaskLabel[]
  blockedByEdges TaskDependency[] @relation("TaskBlocked")
  blockingEdges  TaskDependency[] @relation("TaskBlocking")
  comments       Comment[]
  attachments    Attachment[]
  customFieldValues CustomFieldValue[]

  @@index([workspaceId])
  @@index([projectId, columnId, position])
  @@index([categoryId, columnId, position])
  @@index([parentTaskId])
  @@index([milestoneId])
  @@index([creatorId])
  // The recurrence scheduler's claim query filters on nextRunAt <= now.
  @@index([nextRunAt])
  // The due-date-reminder scheduler's claim query filters on
  // (dueReminderSentAt IS NULL AND dueDate BETWEEN now AND now+lookahead).
  @@index([dueReminderSentAt, dueDate])
  // A template's spawned instances (and the frontend badge's reverse lookup
  // from an instance back to its template's title) are looked up by this.
  @@index([recurrenceTemplateId])
  @@map("tasks")
}

model TaskAssignee {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())

  @@unique([taskId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("task_assignees")
}

model Label {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  color       String
  createdAt   DateTime  @default(now())

  taskLabels TaskLabel[]

  @@unique([projectId, name])
  @@index([workspaceId])
  @@map("labels")
}

model TaskLabel {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  labelId     String
  label       Label     @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([taskId, labelId])
  @@index([workspaceId])
  @@index([labelId])
  @@map("task_labels")
}

// A project-scoped, typed field definition. Shape mirrors Label (the other
// project-scoped, permission-gated definition entity) with two deliberate
// additions: `position`, because unlike labels these are user-reorderable
// (see the reorder endpoint + position.ts#rebalancePositions), and
// `updatedAt`, because unlike a label a definition is meaningfully edited
// over time (mirrors BoardColumn, the other reorderable definition entity).
//
// `type` is IMMUTABLE once created and there is deliberately no route that
// can change it: every stored CustomFieldValue.value was validated against
// exactly one type, and reinterpreting that JSON under a different validator
// has no safe migration. Renaming, and editing a select's `options`, are both
// allowed; see CustomFieldValue below for the stale-value policy that implies.
model CustomFieldDefinition {
  id          String          @id @default(uuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  type        CustomFieldType
  // The allowed option list for `select`/`multi_select` only: a JSON array of
  // unique, non-empty strings. Always `[]` for the other five types. Prisma
  // cannot express "this Json column's shape depends on that enum column", so
  // this invariant is enforced in packages/shared's create/update schemas and
  // re-checked in custom-fields.service.ts — never by the database.
  options     Json            @default("[]")
  position    Float
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  values CustomFieldValue[]

  @@unique([projectId, name])
  @@index([workspaceId])
  @@index([projectId, position])
  @@map("custom_field_definitions")
}

// A thin task<->definition join row, mirroring TaskLabel/TaskAssignee's
// workspaceId-ONLY denormalization. It deliberately does NOT carry projectId
// or categoryId, unlike the full parent-chain convention that primary
// entities (Task, BoardColumn) follow: this is a value-holding join table
// reached only via an already-scoped task, never queried by project or
// category on its own.
//
// `value` is non-nullable. "No value set" is represented by the ABSENCE of
// this row, never by a JSON null, so there is exactly one representation of
// the empty state (the value PUT rejects a null body value with a 422; the
// DELETE route clears).
//
// Stale-value policy: editing a definition's `options` (e.g. removing an
// option that tasks already use) leaves these rows completely untouched. They
// become unenforced legacy data, surfaced as `stale: true` by the value read
// endpoint, and are re-validated against the definition's CURRENT options on
// the next write. Silently deleting a user's data as a side effect of an
// unrelated admin edit is unrecoverable, and blocking option removal whenever
// any task uses that option makes the feature unusable at scale.
model CustomFieldValue {
  id          String                @id @default(uuid())
  workspaceId String
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fieldId     String
  field       CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value       Json
  updatedAt   DateTime              @updatedAt

  @@unique([taskId, fieldId])
  @@index([workspaceId])
  @@index([fieldId])
  @@map("custom_field_values")
}

// A project-scoped, canned task blueprint: a name plus the title/description/
// priority/labels a new task should start with. Shape mirrors Label/
// CustomFieldDefinition (the other project-scoped, permission-gated
// definition entities), but deliberately has NO `position` field and no
// reorder endpoint — templates are consumed via a dropdown in the
// task-creation quick-action, not a positioned/reorderable list (unlike
// BoardColumn/CustomFieldDefinition), so creation-order (`createdAt asc`) is
// sufficient, mirroring Label's own lack of a position field for the same
// reason.
//
// `defaultLabelIds` is a native Postgres `String[]`, not a `Json` column:
// unlike CustomFieldDefinition.options (whose legal shape depends on the
// sibling `type` column), this field is unconditionally a flat list of
// strings, so no Prisma.JsonValue-narrowing helper is needed. It is a soft
// reference list, not FK-enforced: referential integrity is checked at WRITE
// time only (every id must resolve to a Label in this project — see
// task-templates.service.ts#assertLabelIdsInProject, the same IDOR-barrier
// pattern as tasks.service.ts#addLabel's label lookup and
// custom-fields.service.ts#setTaskCustomFieldValue's field lookup). A label
// deleted later simply drops out of the applied set with no cleanup needed.
model TaskTemplate {
  id              String        @id @default(uuid())
  workspaceId     String
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  titleTemplate   String
  description     String?
  priority        TaskPriority?
  defaultLabelIds String[]      @default([])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([projectId, name])
  @@index([workspaceId])
  @@map("task_templates")
}

model Milestone {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  targetDate  DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks Task[]

  @@index([workspaceId])
  @@index([projectId])
  @@map("milestones")
}

model TaskDependency {
  id             String    @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  blockedTaskId  String
  blockedTask    Task      @relation("TaskBlocked", fields: [blockedTaskId], references: [id], onDelete: Cascade)
  blockingTaskId String
  blockingTask   Task      @relation("TaskBlocking", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())

  @@unique([blockedTaskId, blockingTaskId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([blockingTaskId])
  @@map("task_dependencies")
}

// ---------------------------------------------------------------------------
// Phase 4 — Comments, mentions, notifications, attachments
// ---------------------------------------------------------------------------
//
// Mention parsing convention (documented here, see also docs/PHASES.md):
// the frontend's mention-autocomplete inserts opaque `@[userId]` tokens into
// the comment body (never free-text name matching, which would be ambiguous
// with duplicate display names). The server re-parses these tokens at
// comment-creation time and only honors ones that resolve to an active
// workspace member — the token is the source of truth, never trusted
// display text.

model Comment {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation("CommentAuthor", fields: [authorId], references: [id])
  body        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  mentions Mention[]

  @@index([workspaceId])
  @@index([taskId, createdAt])
  @@map("comments")
}

model Mention {
  id              String    @id @default(uuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  commentId       String
  comment         Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUserId String
  mentionedUser   User      @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())

  @@index([workspaceId])
  @@index([commentId])
  @@index([mentionedUserId])
  @@map("mentions")
}

model Notification {
  id              String           @id @default(uuid())
  workspaceId     String
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipientUserId String
  recipient       User             @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  type            NotificationType
  payload         Json             @default("{}")
  readAt          DateTime?
  createdAt       DateTime         @default(now())

  @@index([recipientUserId, createdAt])
  @@index([workspaceId])
  @@map("notifications")
}

model Attachment {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploaderId  String
  uploader    User      @relation("AttachmentUploader", fields: [uploaderId], references: [id])
  filename    String
  contentType String
  sizeBytes   Int
  storageKey  String    @unique
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@index([taskId])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// Phase 5 — Activity feed (separate from the Phase 1 security AuditLogEntry)
// ---------------------------------------------------------------------------
//
// ActivityEvent is a user-facing, ordinary-project-activity feed (task
// created/moved/assigned, comment posted, milestone completed) — NOT a
// security/admin log. It denormalizes human-readable context (task title,
// column names, actor display name) directly into `payload` so the feed can
// render without re-joining to Task/BoardColumn/User at read time, since
// those referenced rows may themselves change or be deleted later.

model ActivityEvent {
  id           String            @id @default(uuid())
  workspaceId  String
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Nullable: category-scoped events (task_created/task_moved/task_assigned/
  // comment_added on a task) populate this; project-level events that have
  // no category in scope (milestone_completed — milestones remain
  // project-scoped, not category-scoped) leave it null. SetNull on category
  // delete so a feed entry never disappears just because its category was
  // later removed — it just becomes a project-level event going forward for
  // visibility-filtering purposes.
  categoryId   String?
  taskCategory TaskCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  actorId      String
  actor        User              @relation("ActivityEventActor", fields: [actorId], references: [id])
  type         ActivityEventType
  payload      Json              @default("{}")
  createdAt    DateTime          @default(now())

  @@index([workspaceId])
  @@index([projectId, createdAt])
  @@index([categoryId])
  @@map("activity_events")
}

// ---------------------------------------------------------------------------
// Platform-wide outbound email configuration
// ---------------------------------------------------------------------------

/// Instance-wide outbound email configuration. Deliberately a SINGLE-ROW
/// table pinned to id = "singleton" (enforced by a hand-written CHECK
/// constraint in the migration, since Prisma cannot model CHECK): the
/// product requirement is one mail configuration for the whole ProjectHub
/// installation, and a fixed PK makes that unrepresentable-otherwise
/// rather than merely conventional.
///
/// Absent row OR enabled = false both mean "email is not configured" and
/// both fall back to the dev console transport — the app keeps working,
/// mail just isn't sent (see email.service.ts).
model PlatformEmailConfig {
  id                 String       @id @default("singleton")
  enabled            Boolean      @default(false)
  host               String
  port               Int
  security           SmtpSecurity @default(starttls)
  /// Null for unauthenticated / IP-allowlisted relays.
  username           String?
  /// AES-256-GCM envelope produced by core/secret-box.ts. NEVER returned
  /// by any serializer — the API exposes only `hasPassword: boolean`.
  passwordCiphertext String?
  fromAddress        String
  fromName           String?
  updatedById        String?
  updatedBy          User?        @relation("PlatformEmailConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("platform_email_configs")
}
